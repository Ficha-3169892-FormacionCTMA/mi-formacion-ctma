# Plantilla para las credenciales de Supabase.
# Copia este archivo como 'secrets.properties' y coloca tus valores reales.
# El archivo 'secrets.properties' está ignorado por Git por razones de seguridad.

# URL base incluyendo el path de la API (ej: https://xyz.supabase.co/rest/v1/)
# IMPORTANTE: Debe terminar con una barra diagonal '/'
SUPABASE_URL=https://reemplaza-con-tu-url.supabase.co/rest/v1/
SUPABASE_ANON_KEY=tu-publishable-key-real-aqui
