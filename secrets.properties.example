# Plantilla para las credenciales de Supabase.
# Copia este archivo como 'secrets.properties' y coloca tus valores reales.
# El archivo 'secrets.properties' está ignorado por Git por razones de seguridad.

# URL base y clave general (por defecto)
SUPABASE_URL=https://reemplaza-con-tu-url.supabase.co/rest/v1/
SUPABASE_PUBLISHABLE_KEY=tu-publishable-key-real-aqui

# Opción opcional: definir URLs/claves específicas por entorno (dev, stage, prod)
# Si no se especifican, se utilizarán las globales SUPABASE_URL y SUPABASE_PUBLISHABLE_KEY.
# SUPABASE_URL_DEV=https://dev.supabase.co/rest/v1/
# SUPABASE_KEY_DEV=tu-key-dev
# SUPABASE_URL_STAGE=https://stage.supabase.co/rest/v1/
# SUPABASE_KEY_STAGE=tu-key-stage
# SUPABASE_URL_PROD=https://prod.supabase.co/rest/v1/
# SUPABASE_KEY_PROD=tu-key-prod
